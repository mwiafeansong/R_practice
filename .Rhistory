W = wilcox_result$statistic,
p_value = wilcox_result$p.value,
p_sig = ifelse(wilcox_result$p.value < 0.05, "Yes", "No"),
alternative = wilcox_result$alternative
# report mddiean, iqr and n() alongside
)
wilcox_table
